<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>D&D 5e Procedural Dungeon Crawler</title>
    <style>
        :root {
            --bg-color: #1a1a1a;
            --panel-color: #2a2a2a;
            --accent-color: #d4af37;
            --text-color: #e0e0e0;
            --danger-color: #ff4d4d;
            --success-color: #4da6ff;
        }

        body {
            font-family: 'Courier New', Courier, monospace;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        #game-container {
            width: 100%;
            max-width: 1000px;
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 20px;
        }

        .panel {
            background-color: var(--panel-color);
            border: 2px solid #444;
            border-radius: 5px;
            padding: 15px;
        }

        h2, h3 {
            color: var(--accent-color);
            margin-top: 0;
            border-bottom: 1px solid #444;
            padding-bottom: 5px;
        }

        /* Character Panel Styles */
        .stat-line {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
        }

        /* Game Screen Styles */
        #display-panel {
            display: flex;
            flex-direction: column;
            height: 600px;
        }

        #output-log {
            flex-grow: 1;
            background-color: #111;
            border: 1px solid #333;
            padding: 10px;
            overflow-y: auto;
            margin-bottom: 15px;
            border-radius: 3px;
        }

        .log-entry {
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .system { color: #888; }
        .combat-player { color: var(--success-color); }
        .combat-enemy { color: var(--danger-color); }
        .loot { color: var(--accent-color); }

        /* Controls Styles */
        #controls-interface {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        button {
            background-color: #333;
            color: var(--text-color);
            border: 1px solid var(--accent-color);
            padding: 10px 15px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            border-radius: 3px;
            transition: all 0.2s;
        }

        button:hover {
            background-color: var(--accent-color);
            color: #000;
        }

        button:disabled {
            border-color: #555;
            color: #555;
            background-color: #222;
            cursor: not-allowed;
        }

        .hidden {
            display: none !important;
        }

        .inventory-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #333;
            padding: 5px 8px;
            margin-bottom: 5px;
            font-size: 0.9em;
        }
    </style>
</head>
<body>

<div id="game-container">
    <div class="panel" id="character-panel">
        <h2>Hero Sheet</h2>
        <div id="char-details">
            <p><strong>Name:</strong> <span id="lbl-name">-</span></p>
            <p><strong>Race/Class:</strong> <span id="lbl-race-class">-</span></p>
            <p><strong>HP:</strong> <span id="lbl-hp">-</span></p>
            <p><strong>AC:</strong> <span id="lbl-ac">-</span></p>
            <p><strong>Position:</strong> (<span id="lbl-coords">0,0</span>)</p>
        </div>
        
        <h3>Abilities</h3>
        <div id="char-stats">
            <div class="stat-line"><span>STR:</span><span id="stat-STR">-</span></div>
            <div class="stat-line"><span>DEX:</span><span id="stat-DEX">-</span></div>
            <div class="stat-line"><span>CON:</span><span id="stat-CON">-</span></div>
            <div class="stat-line"><span>INT:</span><span id="stat-INT">-</span></div>
            <div class="stat-line"><span>WIS:</span><span id="stat-WIS">-</span></div>
            <div class="stat-line"><span>CHA:</span><span id="stat-CHA">-</span></div>
        </div>

        <h3>Equipment</h3>
        <p>Weapon: <span id="lbl-weapon" style="color:var(--accent-color)">None</span></p>
        <p>Armor: <span id="lbl-armor" style="color:var(--accent-color)">None</span></p>

        <h3>Inventory</h3>
        <div id="inventory-list">Empty</div>
    </div>

    <div class="panel" id="display-panel">
        <h2>Dungeon Log</h2>
        <div id="output-log"></div>
        
        <div id="controls-interface">
            <div id="ui-creation">
                <button onclick="generateCharacter()">Roll Random 5e Character</button>
            </div>

            <div id="ui-navigation" class="hidden">
                <h3>Movement</h3>
                <div class="btn-group">
                    <button onclick="move(0, 1)">Go North</button>
                    <button onclick="move(0, -1)">Go South</button>
                    <button onclick="move(1, 0)">Go East</button>
                    <button onclick="move(-1, 0)">Go West</button>
                </div>
                <div class="btn-group" style="margin-top: 10px;">
                    <button id="btn-loot" onclick="lootRoom()" disabled>Search Room</button>
                </div>
            </div>

            <div id="ui-combat" class="hidden">
                <h3 style="color:var(--danger-color)">Combat Encounter!</h3>
                <div class="btn-group">
                    <button onclick="combatRound('attack')">Attack Weapon</button>
                    <button onclick="combatRound('potion')">Drink Potion</button>
                </div>
            </div>

            <div id="ui-gameover" class="hidden">
                <button onclick="location.reload()">Start a New Run</button>
            </div>
        </div>
    </div>
</div>

<script>
    // --- GAME DATABASES ---
    const RACES = ['Human', 'Elf', 'Dwarf', 'Halfling'];
    const CLASSES = [
        { name: 'Fighter', hitDie: 10, weapon: 'Longsword', armor: 'Chain Mail' },
        { name: 'Wizard', hitDie: 6, weapon: 'Quarterstaff', armor: 'Cloth Robes' },
        { name: 'Rogue', hitDie: 8, weapon: 'Dagger', armor: 'Leather Armor' },
        { name: 'Cleric', hitDie: 8, weapon: 'Mace', armor: 'Scale Mail' }
    ];

    const ITEMS = {
        'Longsword': { type: 'weapon', die: '1d8', stat: 'str' },
        'Quarterstaff': { type: 'weapon', die: '1d6', stat: 'str' },
        'Dagger': { type: 'weapon', die: '1d4', stat: 'dex' },
        'Mace': { type: 'weapon', die: '1d6', stat: 'str' },
        'Chain Mail': { type: 'armor', ac: 16 },
        'Leather Armor': { type: 'armor', ac: 11, addDex: true },
        'Scale Mail': { type: 'armor', ac: 14, capDex: 2 },
        'Cloth Robes': { type: 'armor', ac: 10, addDex: true },
        'Potion of Healing': { type: 'consumable' }
    };

    const MONSTER_TEMPLATES = [
        { name: 'Giant Rat', ac: 12, hp: 7, attackBonus: 4, damageDie: '1d4+2' },
        { name: 'Goblin', ac: 15, hp: 7, attackBonus: 4, damageDie: '1d6+2' },
        { name: 'Orc', ac: 13, hp: 15, attackBonus: 5, damageDie: '1d12+3' },
        { name: 'Bugbear', ac: 16, hp: 27, attackBonus: 4, damageDie: '2d8+2' }
    ];

    const ROOM_ADJECTIVES = ['damp', 'forgotten', 'blood-stained', 'echoing', 'shadowy', 'eerie'];
    const ROOM_TYPES = ['stone chamber', 'crypt', 'hallway', 'jail cell', 'vault'];

    // --- STATE ENGINE ---
    let player = {
        name: "Hero", race: "", class: "",
        stats: {}, modifiers: {},
        hp: 0, maxHp: 0, ac: 10,
        inventory: [], equippedWeapon: null, equippedArmor: null,
        x: 0, y: 0
    };

    let dungeonMap = {};
    let currentEnemy = null;

    // --- UTILITIES ---
    function rollDice(diceString) {
        // Parses strings like "1d8", "2d4+2", "1d10-1"
        const parts = diceString.split(/[+-]/);
        const dicePart = parts[0];
        const modifier = diceString.includes('+') ? parseInt(parts[1]) : (diceString.includes('-') ? -parseInt(parts[1]) : 0);
        
        const [num, sides] = dicePart.split('d').map(Number);
        let total = 0;
        for(let i=0; i<num; i++) {
            total += Math.floor(Math.random() * sides) + 1;
        }
        return total + modifier;
    }

    function log(text, type = 'system') {
        const logBox = document.getElementById('output-log');
        const entry = document.createElement('div');
        entry.className = `log-entry ${type}`;
        entry.innerText = text;
        logBox.appendChild(entry);
        logBox.scrollTop = logBox.scrollHeight;
    }

    // --- CHARACTER CORE LOGIC (DnD 5e Rules) ---
    function rollStat() {
        let rolls = [];
        for(let i=0; i<4; i++) rolls.push(Math.floor(Math.random() * 6) + 1);
        rolls.sort();
        rolls.shift(); // Remove the lowest value
        return rolls.reduce((a, b) => a + b, 0);
    }

    function calculateModifier(score) {
        return Math.floor((score - 10) / 2);
    }

    function generateCharacter() {
        player.race = RACES[Math.floor(Math.random() * RACES.length)];
        const classObj = CLASSES[Math.floor(Math.random() * CLASSES.length)];
        player.class = classObj.name;

        const statNames = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];
        statNames.forEach(stat => {
            player.stats[stat] = rollStat();
            // Simple race adjustments
            if(player.race === 'Human') player.stats[stat] += 1;
            player.modifiers[stat] = calculateModifier(player.stats[stat]);
        });

        // Calculate Hit Points based on Hit Die + CON mod
        player.maxHp = classObj.hitDie + player.modifiers['CON'];
        if (player.maxHp <= 0) player.maxHp = 1; // 5e fallback rule
        player.hp = player.maxHp;

        // Give Starting Gear
        player.inventory = ['Potion of Healing'];
        player.equippedWeapon = classObj.weapon;
        player.equippedArmor = classObj.armor;

        log(`Character created! A legendary level 1 ${player.race} ${player.class} begins their trial.`);
        
        // Move to primary map interface
        document.getElementById('ui-creation').classList.add('hidden');
        document.getElementById('ui-navigation').classList.remove('hidden');
        
        recalculateAC();
        updateUI();
        
        // Generate and log the spawn entry
        generateRoom(0, 0, true);
    }

    function recalculateAC() {
        if (!player.equippedArmor) {
            player.ac = 10 + player.modifiers['DEX'];
            return;
        }
        const armor = ITEMS[player.equippedArmor];
        if (armor.addDex) {
            player.ac = armor.ac + player.modifiers['DEX'];
        } else if (armor.capDex !== undefined) {
            player.ac = armor.ac + Math.min(player.modifiers['DEX'], armor.capDex);
        } else {
            player.ac = armor.ac; // Heavy armor variants negate dex
        }
    }

    // --- PROCEDURAL ENGINE ---
    function generateRoom(x, y, isSpawn = false) {
        const key = `${x},${y}`;
        if (dungeonMap[key]) return dungeonMap[key];

        if (isSpawn) {
            dungeonMap[key] = {
                desc: "You stand in a dimly illuminated temple entry. Safe stone pillars anchor the vault overhead. Safe steps lead downward.",
                loot: ['Potion of Healing'],
                enemy: null
            };
            log(dungeonMap[key].desc);
            return dungeonMap[key];
        }

        // Distance scaling calculations
        const distance = Math.abs(x) + Math.abs(y);
        const adj = ROOM_ADJECTIVES[Math.floor(Math.random() * ROOM_ADJECTIVES.length)];
        const type = ROOM_TYPES[Math.floor(Math.random() * ROOM_TYPES.length)];
        
        let room = {
            desc: `You slip inside a ${adj} ${type}.`,
            loot: [],
            enemy: null
        };

        // Standard encounter balance distribution setup
        const spawnChance = Math.random();
        if (spawnChance < 0.45) { // 45% Encounter Probability
            // Scale tier index selector dynamically
            let tier = Math.min(Math.floor(distance / 3), MONSTER_TEMPLATES.length - 1);
            let template = MONSTER_TEMPLATES[tier];
            
            // Add slight variance to healthpools scaling dynamically
            let enemyHp = template.hp + Math.floor(Math.random() * distance);
            room.enemy = {
                name: template.name,
                ac: template.ac,
                hp: enemyHp,
                maxHp: enemyHp,
                attackBonus: template.attackBonus,
                damageDie: template.damageDie
            };
        } else if (spawnChance > 0.75) { // 25% Item Spawn Probability
            const itemKeys = Object.keys(ITEMS);
            room.loot.push(itemKeys[Math.floor(Math.random() * itemKeys.length)]);
        }

        dungeonMap[key] = room;
        log(room.desc);
        return room;
    }

    // --- EXPLORATION MECHANICS ---
    function move(dx, dy) {
        player.x += dx;
        player.y += dy;
        
        log(`Traveling to new coordinates... (${player.x}, ${player.y})`, 'system');
        const room = generateRoom(player.x, player.y);

        if (room.enemy) {
            currentEnemy = { ...room.enemy }; // Clone instantiation
            log(`CRITICAL: A hostile ${currentEnemy.name} breaks from the shadow canvas!`, 'combat-enemy');
            switchToPhase('combat');
        } else {
            switchToPhase('navigation');
        }
        updateUI();
    }

    function lootRoom() {
        const key = `${player.x},${player.y}`;
        const room = dungeonMap[key];
        if (room && room.loot.length > 0) {
            room.loot.forEach(item => {
                player.inventory.push(item);
                log(`You found and pocketed: ${item}`, 'loot');
            });
            room.loot = [];
        }
        updateUI();
    }

    // --- COMBAT PROCESSING ENGINE ---
    function combatRound(playerAction) {
        if (!currentEnemy) return;

        if (playerAction === 'potion') {
            const index = player.inventory.indexOf('Potion of Healing');
            if (index > -1) {
                player.inventory.splice(index, 1);
                const heal = rollDice('2d4+2');
                player.hp = Math.min(player.maxHp, player.hp + heal);
                log(`You consumed a healing draft and restored ${heal} HP.`, 'combat-player');
            } else {
                log(`You scan your layout frantically but find no potions!`, 'system');
                return; // Action didn't occur
            }
        } else if (playerAction === 'attack') {
            // Player Attack Resolution Turn
            const attackRoll = rollDice('1d20');
            const weapon = ITEMS[player.equippedWeapon];
            const mod = player.modifiers[weapon.stat.toUpperCase()];
            const totalAttack = attackRoll + mod;

            log(`You strike with your ${player.equippedWeapon}: Roll d20 (${attackRoll}) + Mod (${mod}) = ${totalAttack} vs Enemy AC (${currentEnemy.ac})`, 'system');

            if (attackRoll === 20 || (attackRoll !== 1 && totalAttack >= currentEnemy.ac)) {
                let damage = rollDice(weapon.die) + mod;
                if (attackRoll === 20) { // Critical hit implementation
                    damage += rollDice(weapon.die);
                    log(`CRITICAL HIT!`, 'combat-player');
                }
                damage = Math.max(1, damage);
                currentEnemy.hp -= damage;
                log(`Success! Your hit inflicts ${damage} raw damage to the ${currentEnemy.name}.`, 'combat-player');
            } else {
                log(`Your attack glances harmlessly off the monster's shell.`, 'system');
            }
        }

        // Check if creature expired
        if (currentEnemy.hp <= 0) {
            log(`Victory! You have slain the dangerous ${currentEnemy.name}!`, 'combat-player');
            // Permanently scrub from world state map dictionary data structures
            dungeonMap[`${player.x},${player.y}`].enemy = null;
            currentEnemy = null;
            switchToPhase('navigation');
            updateUI();
            return;
        }

        // Enemy Retaliation Turn Processing Loop
        const enemyAttack = rollDice('1d20') + currentEnemy.attackBonus;
        log(`${currentEnemy.name} lunges back: Roll (${enemyAttack}) vs Your AC (${player.ac})`, 'system');

        if (enemyAttack >= player.ac) {
            const dmg = rollDice(currentEnemy.damageDie);
            player.hp -= dmg;
            log(`The ${currentEnemy.name} hits you for ${dmg} physical damage.`, 'combat-enemy');
        } else {
            log(`You raise your guard and deflect the creature's blow successfully.`, 'system');
        }

        // Verify player status limits
        if (player.hp <= 0) {
            player.hp = 0;
            log(`Your vision darkens. You fall unconscious onto the stone floor... GAME OVER`, 'combat-enemy');
            switchToPhase('gameover');
        }
        updateUI();
    }

    // --- INVENTORY MANAGEMENT ENGINE ---
    function equipItem(index) {
        const itemKey = player.inventory[index];
        const item = ITEMS[itemKey];
        if (!item) return;

        if (item.type === 'weapon') {
            player.inventory.push(player.equippedWeapon);
            player.equippedWeapon = itemKey;
            player.inventory.splice(index, 1);
            log(`Equipped ${itemKey} as primary weapon.`);
        } else if (item.type === 'armor') {
            player.inventory.push(player.equippedArmor);
            player.equippedArmor = itemKey;
            player.inventory.splice(index, 1);
            log(`Buckled on ${itemKey}.`);
            recalculateAC();
        }
        updateUI();
    }

    // --- PHASE CONTROL INTERFACE MANAGEMENT ---
    function switchToPhase(phase) {
        document.getElementById('ui-creation').classList.add('hidden');
        document.getElementById('ui-navigation').classList.add('hidden');
        document.getElementById('ui-combat').classList.add('hidden');
        document.getElementById('ui-gameover').classList.add('hidden');

        if (phase === 'navigation') document.getElementById('ui-navigation').classList.remove('hidden');
        if (phase === 'combat') document.getElementById('ui-combat').classList.remove('hidden');
        if (phase === 'gameover') document.getElementById('ui-gameover').classList.remove('hidden');
    }

    // --- DOM VIEW RENDERING REFRESH ---
    function updateUI() {
        if (!player.race) return; // Exit update cleanly if character is unrolled

        // Core Labels Text Refresher
        document.getElementById('lbl-name').innerText = player.name;
        document.getElementById('lbl-race-class').innerText = `${player.race} ${player.class}`;
        document.getElementById('lbl-hp').innerText = `${player.hp} / ${player.maxHp}`;
        document.getElementById('lbl-ac').innerText = player.ac;
        document.getElementById('lbl-coords').innerText = `${player.x},${player.y}`;

        // Dynamic Ability Grid Sheet Modifiers Refresher
        const statNames = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];
        statNames.forEach(stat => {
            const val = player.stats[stat];
            const mod = player.modifiers[stat] >= 0 ? `(+${player.modifiers[stat]})` : `(${player.modifiers[stat]})`;
            document.getElementById(`stat-${stat}`).innerText = `${val} ${mod}`;
        });

        // Equipment Slot String Renderers
        document.getElementById('lbl-weapon').innerText = player.equippedWeapon || 'None';
        document.getElementById('lbl-armor').innerText = player.equippedArmor || 'None';

        // Check if current coordinate room holds uncollected loot
        const room = dungeonMap[`${player.x},${player.y}`];
        const btnLoot = document.getElementById('btn-loot');
        if(room && room.loot.length > 0) {
            btnLoot.disabled = false;
            btnLoot.innerText = `Search Room (${room.loot.length} item found!)`;
        } else {
            btnLoot.disabled = true;
            btnLoot.innerText = `Search Room`;
        }

        // Inventory Dynamic DOM Generator Tree Loop
        const invContainer = document.getElementById('inventory-list');
        invContainer.innerHTML = '';
        if (player.inventory.length === 0) {
            invContainer.innerText = 'Empty';
        } else {
            player.inventory.forEach((itemKey, idx) => {
                const item = ITEMS[itemKey];
                const div = document.createElement('div');
                div.className = 'inventory-item';
                
                let actionBtnHtml = '';
                if (item && (item.type === 'weapon' || item.type === 'armor')) {
                    actionBtnHtml = `<button size="small" style="padding:2px 5px; font-size:10px;" onclick="equipItem(${idx})">Equip</button>`;
                }
                
                div.innerHTML = `<span>${itemKey}</span> ${actionBtnHtml}`;
                invContainer.appendChild(div);
            });
        }
    }
</script>
</body>
</html>
